{
  "name": "cooperise",
  "private": true,
  "version": "1.0.0",
  "productName": "Cooperise",
  "description": "Cooperise",
  "author": "speedx",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8083",
    "build": "vue-tsc -b && vite build && vite build --mode h5",
    "build:h5": "vite build --mode h5",
    "preview": "vite preview --port 8083",
    "build:lan": "vue-tsc -b && vite build --mode lan && vite build --mode h5-lan",
    "preview:lan": "vite preview --mode lan",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:preview": "vite build --mode desktop && electron .",
    "electron:build": "vite build --mode desktop && electron-builder --win --x64",
    "electron:build:mac": "vite build --mode desktop && electron-builder --mac --arm64 --x64",
    "ios:build": "vue-tsc -b && vite build --mode ios",
    "ios:sync": "vite build --mode ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@logicflow/core": "1.2.10",
    "@logicflow/extension": "1.2.10",
    "@vxe-ui/plugin-render-antd": "4.4.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "vant": "^4.10.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vxe-gantt": "^4.6.5",
    "vxe-pc-ui": "^4.16.23",
    "vxe-table": "4.20.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@plugin-web-update-notification/vite": "^2.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "lightningcss": "1.32.0",
    "postcss": "^8.5.22",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-qiankun": "^1.0.11",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.speedx.cooperise",
    "productName": "Cooperise",
    "copyright": "speedx",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "afterPack": "build/mac-adhoc-sign.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cooperise-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "artifactName": "Cooperise-${version}-${arch}.${ext}",
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Cooperise",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "Cooperise ${version}",
      "artifactName": "Cooperise-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cooperise"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
